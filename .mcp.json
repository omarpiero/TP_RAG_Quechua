{
  "mcpServers": {
    "sonarqube": {
      "command": "java",
      "args": ["-Djdk.net.unixdomain.tmpdir=${SONARQUBE_MCP_HOME}/tmp",
               "-jar", "${SONARQUBE_MCP_JAR}"],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_ORG": "${SONARQUBE_ORG}",
        "SONARQUBE_READ_ONLY": "true",
        "STORAGE_PATH": "${SONARQUBE_MCP_HOME}/storage-cloud"
      }
    },
    "sonarqube-local": {
      "command": "java",
      "args": ["-Djdk.net.unixdomain.tmpdir=${SONARQUBE_MCP_HOME}/tmp",
               "-jar", "${SONARQUBE_MCP_JAR}"],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN_LOCAL}",
        "SONARQUBE_URL": "http://localhost:9000",
        "SONARQUBE_READ_ONLY": "true",
        "STORAGE_PATH": "${SONARQUBE_MCP_HOME}/storage"
      }
    }
  }
}
