# Copiar a .env (nunca se versiona) como referencia de las variables necesarias.
# IMPORTANTE: Claude Code NO carga .env por sí solo. Las variables que usa .mcp.json deben existir en el
# entorno de Windows antes de abrir Claude Code (p. ej., `setx SONARQUBE_TOKEN "..."` y reabrir la terminal).
# SonarQube Cloud: token de usuario y clave de la organización
SONARQUBE_TOKEN=
SONARQUBE_ORG=
# SonarQube Community local (http://localhost:9000): token de USUARIO
SONARQUBE_TOKEN_LOCAL=
# Para sonar-scanner local
SONAR_TOKEN=
# Ollama (PMV1)
OLLAMA_HOST=http://127.0.0.1:11434
